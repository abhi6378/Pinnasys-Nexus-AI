# OpenAI API Key - Get one at https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Database URL - Defaults to postgres if not provided
DATABASE_URL=postgres// 

# Composio API Key — Get one at https://app.composio.dev/
# Optional: tools are disabled if not set; the app runs normally without it.
COMPOSIO_API_KEY=your_composio_api_key_here

# Google sign-in
# Production clients, including the future React frontend, should use FastAPI
# /auth/google, /auth/me, and /auth/logout. Streamlit is kept as a local/dev
# compatibility shell and does not get productized Google login UI in this pass.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SINTRA_SESSION_SECRET=replace-with-a-long-random-secret
# Set to 1 in production after workspace memberships are ready.
SINTRA_AUTH_REQUIRED=0
# Production must use explicit origins, not "*", when auth/cookies are enabled.
SINTRA_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000
# Keep secure cookies in production. Set false only for local HTTP development.
SINTRA_SESSION_COOKIE_SECURE=false
SINTRA_API_BASE_URL=http://localhost:8000
# Local/dev escape hatch only. Do not enable in production.
SINTRA_ALLOW_INSECURE_DEV_AUTH=0
# Local/dev database bootstrap only. Production should run: alembic upgrade head.
SINTRA_ALLOW_SCHEMA_BOOTSTRAP=0
# Temporary local upgrade shim only; production should fail if canonical columns are missing.
SINTRA_ALLOW_LEGACY_SCHEMA_FALLBACKS=0
# Browser Google sign-in should use strict double-submit CSRF.
SINTRA_STRICT_GOOGLE_CSRF=1
# Temporary Composio SDK escape hatch only; prefer connected_account_id/version resolution.
COMPOSIO_ALLOW_VERSION_CHECK_BYPASS=0

# Optional: Port for FastAPI server (if you choose to use one)
# PORT=8000
