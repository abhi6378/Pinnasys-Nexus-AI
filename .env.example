# OpenAI API Key - Get one at https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Database URL - Defaults to postgres if not provided
DATABASE_URL=postgres// 

# Composio API Key — Get one at https://app.composio.dev/
# Optional: tools are disabled if not set; the app runs normally without it.
COMPOSIO_API_KEY=your_composio_api_key_here

# Google sign-in
# Production clients, including the future React frontend, should use FastAPI
# /auth/google, /auth/me, and /auth/logout. Streamlit is kept as a local/dev
# compatibility shell and does not get productized Google login UI in this pass.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SINTRA_SESSION_SECRET=replace-with-a-long-random-secret
# Set to 1 in production after workspace memberships are ready.
SINTRA_AUTH_REQUIRED=0
SINTRA_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000
SINTRA_SESSION_COOKIE_SECURE=false
SINTRA_API_BASE_URL=http://localhost:8000

# Optional: Port for FastAPI server (if you choose to use one)
# PORT=8000
